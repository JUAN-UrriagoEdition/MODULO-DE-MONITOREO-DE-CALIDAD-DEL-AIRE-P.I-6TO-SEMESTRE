<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ── Header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#13212A"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AIR QUALITY MONITOR"
                android:textColor="#E8F4FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P.I6Def · ESP32-S3 · CO | NO₂ | CO₂ | VOC"
                android:textColor="#6A85A0"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"/>

            <!-- Conexión -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_conexion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Desconectado"
                    android:textColor="#FF3C3C"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tv_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP: —"
                    android:textColor="#6A85A0"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="start">

                <Button
                    android:id="@+id/btn_config"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="IP"
                    android:textSize="12sp"
                    android:backgroundTint="#1E2D3D"
                    android:textColor="#00D9FF"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btn_conectar"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="CONECTAR"
                    android:textSize="12sp"
                    android:backgroundTint="#00A060"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btn_desconectar"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="DESCONECTAR"
                    android:textSize="12sp"
                    android:backgroundTint="#1E2D3D"
                    android:textColor="#FF3C3C"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Estado actual ── -->
        <LinearLayout
            android:id="@+id/card_estado"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#00A060"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTADO: "
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPOSO"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- ── 4 Gauges en grid 2x2 ── -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginBottom="10dp">

            <!-- CO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="#13212A"
                android:gravity="center"
                android:layout_margin="4dp">

                <View
                    android:id="@+id/gauge_co"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#00D99D"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CO"
                    android:textColor="#6A85A0"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tv_co"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— ppm"
                    android:textColor="#FFB300"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monóxido de Carbono"
                    android:textColor="#6A85A0"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- NO2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="#13212A"
                android:gravity="center"
                android:layout_margin="4dp">

                <View
                    android:id="@+id/gauge_no2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#00D99D"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NO₂"
                    android:textColor="#6A85A0"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tv_no2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— ppm"
                    android:textColor="#00D9FF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dióxido de Nitrógeno"
                    android:textColor="#6A85A0"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- CO2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="#13212A"
                android:gravity="center"
                android:layout_margin="4dp">

                <View
                    android:id="@+id/gauge_co2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#00D99D"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CO₂"
                    android:textColor="#6A85A0"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tv_co2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— ppm"
                    android:textColor="#00FF9D"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dióxido de Carbono"
                    android:textColor="#6A85A0"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- VOC -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:background="#13212A"
                android:gravity="center"
                android:layout_margin="4dp">

                <View
                    android:id="@+id/gauge_voc"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#00D99D"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOC"
                    android:textColor="#6A85A0"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tv_voc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— ppb"
                    android:textColor="#BB86FC"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gases Volátiles"
                    android:textColor="#6A85A0"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </GridLayout>

        <!-- ── Gráficas históricas ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HISTÓRICO (últimos 60s)"
            android:textColor="#6A85A0"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart_co"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart_no2"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart_co2"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chart_voc"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
